# COLLAPSE / Atlas configuration
# Copy to .env and export before launching your DAW, or set in the shell.

# mock (default) = local IR generator, no network
# live = HTTP call to Atlas
ATLAS_MODE=mock

# Required when ATLAS_MODE=live
ATLAS_API_KEY=

# Override if Moth documents a different endpoint
ATLAS_BASE_URL=https://platform.mothquantum.com/api/v1/engines/run

# Engine id from Atlas (sound / whatever the dashboard shows)
ATLAS_ENGINE_ID=sound
